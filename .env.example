# ---------------------------------------------------------------------------
# IEEE-VIT Enrollments API - environment variables
# Copy to `.env` for local development. On Render, set these in the dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Neon Postgres connection string (Neon console -> Connect, "pooled").
# Use sslmode=verify-full. "pglite://memory" = throw-away in-memory database.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Long random strings (e.g. `openssl rand -hex 32`), different from each other
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# "Sign in with Google": OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console -> APIs & Services -> Credentials. Add your site URLs
# (e.g. http://localhost:5173 and the Vercel domain) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Local testing only: log in with just an email (no Google). The server
# refuses to start if this is true while NODE_ENV=production.
DEV_LOGIN=false

# Only Google accounts on this domain can register as candidates
ALLOWED_EMAIL_DOMAIN=vitstudent.ac.in

# Comma separated admin allow-lists. Superadmins can manage tasks, slots,
# settings and export data; admins can review candidates and run interviews.
SUPERADMIN_EMAILS=
ADMIN_EMAILS=

# Frontend URL(s) allowed to call the API (comma separated) and the public
# site URL used in email links
CLIENT_ORIGINS=https://enrollments.ieeevit.org
APP_URL=https://enrollments.ieeevit.org

# "lax" when the frontend proxies /api through its own domain (default setup).
# "none" only if the browser calls this API directly from a different site.
COOKIE_SAMESITE=lax

# Email. On Render (free plan blocks SMTP) use Brevo's HTTPS API: create an API
# key in Brevo (SMTP & API -> API Keys) and verify the sender address there.
BREVO_API_KEY=
# Sender address (must be verified in Brevo)
MAIL_FROM=ieee@vit.ac.in
# Local-only alternative: Gmail account + App Password over SMTP
MAIL_USER=
MAIL_PASS=

# Secret for POST /api/cron/meeting-links (external schedulers)
CRON_SECRET=

# Send meeting links from inside the web process every minute (default true)
ENABLE_INTERNAL_SCHEDULER=true
